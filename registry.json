{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "robocn",
  "homepage": "{REGISTRY_URL}",
  "items": [
    {
      "name": "robot-kinematics",
      "type": "registry:lib",
      "title": "Robot kinematics",
      "description": "Dependency-free inverse and forward kinematics: analytic two-link elbow, FABRIK for longer chains, closed-form delta IK, isometric projection.",
      "categories": [
        "robotics",
        "math"
      ],
      "files": [
        {
          "path": "src/lib/robocn/kinematics.ts",
          "type": "registry:lib",
          "target": "@lib/robocn/kinematics.ts"
        }
      ]
    },
    {
      "name": "robot-style",
      "type": "registry:lib",
      "title": "Robot style",
      "description": "The shared visual language: size scale, paint variants, palette resolution from CSS variables, and the capsule limb geometry every machine is drawn from.",
      "categories": [
        "robotics",
        "theming"
      ],
      "registryDependencies": [
        "{REGISTRY_URL}/r/robot-kinematics.json"
      ],
      "files": [
        {
          "path": "src/lib/robocn/style.ts",
          "type": "registry:lib",
          "target": "@lib/robocn/style.ts"
        }
      ],
      "cssVars": {
        "light": {
          "robot-shell": "oklch(0.72 0.17 47)",
          "robot-metal": "oklch(0.74 0.012 250)",
          "robot-dark": "oklch(0.32 0.02 250)",
          "robot-accent": "oklch(0.72 0.15 176)",
          "robot-glow": "oklch(0.78 0.16 176)",
          "robot-grid": "oklch(0.62 0.02 250)"
        },
        "dark": {
          "robot-shell": "oklch(0.7 0.18 47)",
          "robot-metal": "oklch(0.72 0.015 250)",
          "robot-dark": "oklch(0.26 0.02 250)",
          "robot-accent": "oklch(0.84 0.16 176)",
          "robot-glow": "oklch(0.88 0.17 176)",
          "robot-grid": "oklch(0.55 0.02 250)"
        }
      },
      "css": {
        "@keyframes robocn-spin": {
          "to": {
            "transform": "rotate(360deg)"
          }
        },
        "@keyframes robocn-spray": {
          "from": {
            "transform": "translateX(0) scale(1)",
            "opacity": "0.85"
          },
          "to": {
            "transform": "translateX(7px) scale(0.35)",
            "opacity": "0"
          }
        },
        "@keyframes robocn-spark": {
          "from": {
            "transform": "translateX(0) scale(1)",
            "opacity": "1"
          },
          "to": {
            "transform": "translateX(5px) scale(0.2)",
            "opacity": "0"
          }
        },
        "@keyframes robocn-pulse": {
          "50%": {
            "opacity": "0.45"
          }
        },
        "@keyframes robocn-scan": {
          "0%, 100%": {
            "transform": "rotate(-16deg)"
          },
          "50%": {
            "transform": "rotate(16deg)"
          }
        },
        "@keyframes robocn-blink": {
          "0%, 92%, 100%": {
            "transform": "scaleY(1)"
          },
          "95%": {
            "transform": "scaleY(0.08)"
          }
        },
        ".robocn-spin": {
          "animation": "robocn-spin 1.1s linear infinite"
        },
        ".robocn-spray": {
          "animation": "robocn-spray 0.8s linear infinite"
        },
        ".robocn-spark": {
          "animation": "robocn-spark 0.5s ease-out infinite"
        },
        ".robocn-pulse": {
          "animation": "robocn-pulse 1.1s ease-in-out infinite"
        },
        ".robocn-scan": {
          "animation": "robocn-scan 1.6s ease-in-out infinite"
        },
        ".robocn-blink": {
          "animation": "robocn-blink 5.4s ease-in-out infinite"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".robocn-spin, .robocn-spray, .robocn-spark, .robocn-pulse, .robocn-scan, .robocn-blink": {
            "animation": "none"
          }
        }
      }
    },
