# robocn Studio — see docs/studio.md. The docs site and the workbench need none of this.

# Postgres. `pnpm db:migrate` creates the tables.
DATABASE_URL=postgres://user:password@localhost:5432/robocn_studio

# `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Production only. In development the base URL comes from the request, on whatever port.
# BETTER_AUTH_URL=https://robocn.dev
# Extra hosts a production deployment answers on, comma separated.
# STUDIO_ALLOWED_HOSTS=studio.example.com

# Optional. Set it and uploads go to Vercel Blob (private) instead of Postgres.
# BLOB_READ_WRITE_TOKEN=

# Optional. The integration tests run against it and are skipped without it.
# DATABASE_URL_TEST=postgres://user:password@localhost:5432/robocn_studio_test
