{
  "name": "robocn",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn-compatible registry of robot components: articulated arms in SVG and WebGL, SCARA, delta and gantry cells, mobile robots, robotic animals and sensor displays — all solving their own kinematics, themed with CSS variables, installed as source.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "shadcn-registry",
    "registry",
    "react",
    "nextjs",
    "typescript",
    "tailwindcss",
    "svg",
    "three",
    "react-three-fiber",
    "webgl",
    "robot",
    "robotics",
    "kinematics",
    "inverse-kinematics",
    "fabrik",
    "robot-arm",
    "animation",
    "components",
    "ui",
    "design-system"
  ],
  "homepage": "https://robocn.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimMikeladze/robocn.git"
  },
  "bugs": {
    "url": "https://github.com/TimMikeladze/robocn/issues"
  },
  "author": "Tim Mikeladze <tim.mikeladze@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm generate && next dev",
    "postinstall": "node scripts/setup-skills.mjs",
    "build": "pnpm generate && pnpm registry:build && next build",
    "generate": "pnpm workbench:prepare && pnpm gallery:prepare",
    "workbench:prepare": "node scripts/build-workbench.mjs",
    "gallery:prepare": "node scripts/build-gallery.mjs",
    "start": "next start",
    "lint": "eslint",
    "registry:build": "node scripts/build-registry.mjs",
    "og": "node scripts/build-og.mjs",
    "shots": "node scripts/build-shots.mjs",
    "test": "pnpm generate && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
